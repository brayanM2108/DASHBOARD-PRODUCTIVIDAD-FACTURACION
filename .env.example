# ============================================
# Variables de entorno para Docker Compose
# Copiar a .env y reemplazar valores reales
# ============================================

# ── MariaDB ──────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=dashboard_db
MYSQL_USER=dashboard_user
MYSQL_PASSWORD=dashboard_pass

# ── Backend / FastAPI ────────────────────────
APP_NAME=Dashboard-Facturacion
API_PREFIX=/api
DATABASE_URL=mysql+pymysql://dashboard_user:dashboard_pass@mariadb:3306/dashboard_db
JWT_SECRET=cambiar-por-clave-segura-generada-aleatoriamente
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
ELECTRONIC_BILLING_PARQUET=/app/backend/persisted_data/df_fact_elec.parquet
LOG_LEVEL=INFO

# ── Dominio (para SSL con Let's Encrypt) ────
DOMAIN=ejemplo.com
